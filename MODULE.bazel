module(
    name = "eros_forge",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")

eros_host_tools = use_extension("//bazel/toolchain:host_tools.bzl", "eros_host_tools")
use_repo(eros_host_tools, "eros_host_tools")

register_toolchains(
    "//bazel/tools:foreign_cmake_toolchain",
    "//bazel/tools:foreign_make_toolchain",
    "//bazel/tools:foreign_m4_toolchain",
    "//bazel/toolchain:cc-toolchain-linux-x86_64",
    "//bazel/toolchain:cc-toolchain-linux-arm64",
    "//bazel/toolchain:cc-toolchain-x86_64-to-arm64",
    "//bazel/toolchain:cc-toolchain-arm64-to-arm64",
    "//bazel/toolchain:reject-unsupported-linux-x86_64",
    "//bazel/toolchain:reject-unsupported-linux-arm64",
    "//bazel/toolchain:reject-unsupported-linux-x86_64-cross-arm64",
    "//bazel/toolchain:reject-unsupported-linux-arm64-cross-arm64",
)
