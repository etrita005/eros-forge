load("//bazel:deb.bzl", "eros_test_package", "pkg_eros_tar")
load("//bazel:runtime.bzl", "eros_cc_binary")

package(default_visibility = ["//visibility:public"])
eros_cc_binary(name = "native", srcs = ["native.cc"])
eros_cc_binary(name = "split_dwarf_negative", srcs = ["native.cc"], copts = ["-gsplit-dwarf"], tags = ["manual"])
pkg_eros_tar(name = "native_tar", srcs = [":native"], package = "forge-native-debug")
eros_test_package(name = "native_test_package", srcs = [":native"], package = "forge-native-debug", entry_points = ["bin/native"])
pkg_eros_tar(name = "native_symbols_tar", srcs = [":native"], output_group = "eros_debug_info", package = "forge-native-symbols")
pkg_eros_tar(name = "conan_symbols_tar", srcs = ["//tests/fixtures/link:foo"], output_group = "eros_debug_info", package = "forge-conan-symbols")
