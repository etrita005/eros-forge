load("@eros_forge//bazel:deb.bzl", "pkg_eros_deb", "pkg_eros_deb_multiarch", "pkg_eros_tar")
load("@eros_forge//bazel:runtime.bzl", "eros_cc_binary")

eros_cc_binary(
    name = "app",
    srcs = ["main.cc"],
    deps = ["@eros_forge//tests/fixtures/link:foo"],
)

pkg_eros_tar(name = "payload", srcs = [":app"], package = "forge-consumer")
pkg_eros_deb(
    name = "deb",
    package_name = "forge-consumer",
    data = ":payload",
    description = "External module public API compatibility",
    maintainer = "Forge Tests <forge@example.invalid>",
)
pkg_eros_deb_multiarch(
    name = "multiarch",
    package_name = "forge-consumer",
    data = ":payload",
    presets = ["linux_arm64", "linux_arm64_cross_arm64"],
    description = "External module transition label resolution",
    maintainer = "Forge Tests <forge@example.invalid>",
)
