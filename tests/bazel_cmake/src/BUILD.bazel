load("@eros_forge//bazel:cmake_forge.bzl", "cmake_forge")
load("@rules_cc//cc:defs.bzl", "cc_library")

filegroup(
    name = "src_files",
    srcs = glob(["*.cpp", "lib/*.cpp", "lib/*.h", "CMakeLists.txt"]),
    visibility = ["//visibility:private"],
)

cmake_forge(
    name = "hello",
    lib_source = ":src_files",
    out_binaries = ["hello_cmake"],
    out_static_libs = ["libmath_utils_static.a"],
    out_shared_libs = ["libmath_utils_shared.so"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "math_utils",
    hdrs = ["lib/math_utils.h"],
    deps = [":hello"],
    visibility = ["//visibility:public"],
)
