load("@eros_forge//bazel:cmake_conan_forge.bzl", "cmake_conan_forge")

cmake_conan_forge(
    name = "hello",
    conanfile = "conanfile.txt",
    cmake_lists = "CMakeLists.txt",
    srcs = [
        "main.cpp",
        "mylib.cpp",
        "mylib.h",
    ],
    target_name = "hello",
    out_binary = "hello",
    out_static_libs = ["libmylib_static.a"],
    out_shared_libs = ["libmylib_shared.so"],
    visibility = ["//visibility:public"],
)
