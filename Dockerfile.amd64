FROM ubuntu@sha256:a2d43bffc46670d7108bb3c0468c67c5557c4c92e83e1e34cbff1322ad1b94dc

COPY docker/ubuntu.sources /etc/apt/sources.list.d/ubuntu.sources

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        binutils binutils-aarch64-linux-gnu ca-certificates curl dpkg-dev file \
        g++-13 g++-13-aarch64-linux-gnu gcc-13 gcc-13-aarch64-linux-gnu \
        gdb git libc6-dev-arm64-cross libstdc++-13-dev-arm64-cross \
        m4 make patch python3 python3-pip python3-setuptools python3-wheel \
        tar unzip xz-utils \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements.lock /tmp/forge-requirements.lock
RUN python3 -m pip install --break-system-packages --no-build-isolation \
        --require-hashes --no-cache-dir -r /tmp/forge-requirements.lock \
    && rm /tmp/forge-requirements.lock

RUN (curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
        https://releases.bazel.build/9.0.0/release/bazel-9.0.0-linux-x86_64 \
        -o /usr/local/bin/bazel \
    || curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
        https://github.com/bazelbuild/bazel/releases/download/9.0.0/bazel-9.0.0-linux-x86_64 \
        -o /usr/local/bin/bazel) \
    && printf '%s  %s\n' \
        c44a93f25398c68f904fa1d19b61d321de6c0d2f09dca375d7bc0dc9b9428403 \
        /usr/local/bin/bazel | sha256sum -c - \
    && chmod 0755 /usr/local/bin/bazel

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
