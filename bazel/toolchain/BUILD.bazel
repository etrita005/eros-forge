# =============================================================================
# Platforms
# =============================================================================

platform(
    name = "linux_x86_64_platform",
    constraint_values = NATIVE_X86_64,
)

platform(
    name = "linux_arm64_platform",
    constraint_values = NATIVE_ARM64,
)

platform(
    name = "linux_arm64_cross_platform",
    constraint_values = CROSS_ARM64,
)

# =============================================================================
# Toolchains (table-driven; tool binaries declared via @eros_host_tools)
# =============================================================================

# Native x86_64: host=x86_64, target=x86_64
eros_cc_toolchain(
    name = "cc-toolchain-x86_64",
    toolchain_name = "cc-toolchain-linux-x86_64",
    config_key = "linux_x86_64",
    exec_compatible_with = EXEC_X86_64,
    target_compatible_with = NATIVE_X86_64,
    host_tools = "@eros_host_tools//:native_all",
)

# Native ARM64: host=arm64, target=arm64
eros_cc_toolchain(
    name = "cc-toolchain-arm64-native",
    toolchain_name = "cc-toolchain-linux-arm64",
    config_key = "linux_arm64",
    exec_compatible_with = EXEC_ARM64,
    target_compatible_with = NATIVE_ARM64,
    host_tools = "@eros_host_tools//:native_all",
)

# Cross: x86_64 host -> arm64 target (custom glibc)
eros_cc_toolchain(
    name = "cc-toolchain-arm64-cross-from-x86_64",
    toolchain_name = "cc-toolchain-x86_64-to-arm64",
    config_key = "linux_x86_64_cross_arm64",
    exec_compatible_with = EXEC_X86_64,
    target_compatible_with = CROSS_ARM64,
    host_tools = "@eros_host_tools//:cross_arm64_all",
)

# Cross: arm64 host -> arm64 target (custom glibc)
eros_cc_toolchain(
    name = "cc-toolchain-arm64-cross-from-arm64",
    toolchain_name = "cc-toolchain-arm64-to-arm64",
    config_key = "linux_arm64_cross_arm64",
    exec_compatible_with = EXEC_ARM64,
    target_compatible_with = CROSS_ARM64,
    host_tools = "@eros_host_tools//:cross_arm64_all",
)
