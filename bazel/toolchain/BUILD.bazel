load(":environment.bzl", "validate_environment")
load(":eros_cc_toolchains.bzl", "declare_eros_toolchains")

package(default_visibility = ["//visibility:public"])

constraint_setting(name = "glibc_type", default_constraint_value = ":glibc_native")
constraint_value(name = "glibc_native", constraint_setting = ":glibc_type")
constraint_value(name = "glibc_cross", constraint_setting = ":glibc_type")
constraint_setting(name = "cross_execution_host")
constraint_value(name = "from_x86_64", constraint_setting = ":cross_execution_host")
constraint_value(name = "from_arm64", constraint_setting = ":cross_execution_host")

validate_environment(name = "validate_environment")

filegroup(name = "native_inputs", srcs = ["@eros_host_tools//:native_all", ":validate_environment"])
filegroup(name = "cross_arm64_inputs", srcs = ["@eros_host_tools//:cross_arm64_all", ":validate_environment"])

declare_eros_toolchains()

# The target preset may be cross/sanitized, but a build-time program must remain
# runnable with the native ABI and the execution configuration's clean features.
genrule(
    name = "exec_smoke",
    srcs = ["@eros_host_tools//:native_all", ":validate_environment"],
    tools = ["//tests/fixtures/basic:native"],
    outs = ["exec_smoke.txt"],
    cmd = "$(location //tests/fixtures/basic:native) > $@",
    tags = ["manual", "no-remote-exec"],
)

exports_files(["environment.py", "environment_spec.json", "export_runtime.sh", "generate_files.py", "toolchain_data.bzl"])
