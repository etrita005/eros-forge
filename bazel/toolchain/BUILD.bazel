load(":eros_cc_toolchains.bzl", "eros_cc_toolchain")

package(default_visibility = ["//visibility:public"])

constraint_setting(
    name = "glibc_type",
    default_constraint_value = ":glibc_native",
)

constraint_value(
    name = "glibc_native",
    constraint_setting = ":glibc_type",
)

constraint_value(
    name = "glibc_cross",
    constraint_setting = ":glibc_type",
)

# =============================================================================
# Config settings (driven by --define). Used by cmake_forge / cmake_conan_forge
# select()s and by the platform/sanitizer selection logic.
# =============================================================================

config_setting(
    name = "linux_x86_64",
    define_values = {"eros_config": "linux_x86_64"},
)

config_setting(
    name = "linux_arm64",
    define_values = {"eros_config": "linux_arm64"},
)

config_setting(
    name = "linux_x86_64_cross_arm64",
    define_values = {"eros_config": "linux_x86_64_cross_arm64"},
)

config_setting(
    name = "linux_arm64_cross_arm64",
    define_values = {"eros_config": "linux_arm64_cross_arm64"},
)

# -----------------------------------------------------------------------------
# Auto-detect native config (--config=auto sets eros_config=auto).
#
# These match ONLY when eros_config=auto AND the target platform's cpu constraint
# is the host arch (the default target platform is the host platform, so for a
# native build with no --platforms the cpu constraint reflects the host). They
# never conflict with the explicit linux_<arch> configs above, because those set
# eros_config to a concrete value rather than "auto".
#
# This is the idiomatic Bazel way to drive native selection from platform
# constraints instead of an --define convention, and it makes the README's
# "auto-detect host architecture" statement true.
# -----------------------------------------------------------------------------

config_setting(
    name = "auto_x86_64",
    define_values = {"eros_config": "auto"},
    constraint_values = ["@platforms//cpu:x86_64"],
)

config_setting(
    name = "auto_arm64",
    define_values = {"eros_config": "auto"},
    constraint_values = ["@platforms//cpu:arm64"],
)

config_setting(
    name = "cmake_debug",
    define_values = {"cmake_build_type": "Debug"},
)

config_setting(
    name = "linux_x86_64_debug",
    define_values = {
        "eros_config": "linux_x86_64",
        "cmake_build_type": "Debug",
    },
)

config_setting(
    name = "linux_arm64_debug",
    define_values = {
        "eros_config": "linux_arm64",
        "cmake_build_type": "Debug",
    },
)

config_setting(
    name = "linux_arm64_cross_arm64_debug",
    define_values = {
        "eros_config": "linux_arm64_cross_arm64",
        "cmake_build_type": "Debug",
    },
