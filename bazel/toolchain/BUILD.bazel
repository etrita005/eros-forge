load(":cc_toolchain_config.bzl", "cc_toolchain_config")
load("@rules_cc//cc:defs.bzl", "cc_toolchain", "cc_toolchain_suite")

# =============================================================================
# Platform definitions
# =============================================================================

# Platform for ARM64 native compilation (on ARM64 host)
platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

# Platform for x86_64 native compilation (on x86_64 host)
platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# Platform for cross-compilation: x86_64 host -> ARM64 target
platform(
    name = "linux_arm64_cross",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    exec_properties = {
        "cross_compile": "true",
    },
)

# =============================================================================
# Toolchain configurations
# =============================================================================

# ARM64 cross-compilation toolchain configuration (x86_64 host -> ARM64 target)
# Uses custom glibc for compatibility with older target systems
cc_toolchain_config(
    name = "linux_arm64_cross_config",
    cpu = "aarch64",
    compiler = "gcc",
    target_system_name = "aarch64-linux-gnu",
    target_libc = "glibc_2.27",
    abi_version = "aarch64",
    abi_libc_version = "2.27",
    toolchain_identifier = "aarch64-linux-gnu-cross-toolchain",
    host_system_name = "x86_64-linux-gnu",
    gcc_path = "/usr/bin/aarch64-linux-gnu-gcc",
    gxx_path = "/usr/bin/aarch64-linux-gnu-g++",
    ld_path = "/usr/bin/aarch64-linux-gnu-ld",
    ar_path = "/usr/bin/aarch64-linux-gnu-ar",
    cpp_path = "/usr/bin/aarch64-linux-gnu-cpp",
    gcov_path = "/usr/bin/aarch64-linux-gnu-gcov",
    nm_path = "/usr/bin/aarch64-linux-gnu-nm",
    objdump_path = "/usr/bin/aarch64-linux-gnu-objdump",
    strip_path = "/usr/bin/aarch64-linux-gnu-strip",
    cxx_builtin_include_directories = [
        "/usr/include/c++/13",
        "/usr/include/aarch64-linux-gnu/c++/13",
        "/usr/include/c++/13/backward",
        "/usr/lib/gcc-cross/aarch64-linux-gnu/13/include",
        "/usr/lib/gcc-cross/aarch64-linux-gnu/13/include-fixed",
        "/usr/lib/gcc/aarch64-linux-gnu/13/include",
        "/usr/lib/gcc/aarch64-linux-gnu/13/include-fixed",
        "/usr/aarch64-linux-gnu/include",
        "/usr/include/aarch64-linux-gnu",
        "/usr/include",
    ],
)

# ARM64 native toolchain configuration (ARM64 host -> ARM64 target)
cc_toolchain_config(
    name = "linux_arm64_native_config",
    cpu = "aarch64",
    compiler = "gcc",
    target_system_name = "aarch64-linux-gnu",
    target_libc = "glibc_native",
    abi_version = "aarch64",
    abi_libc_version = "native",
    toolchain_identifier = "aarch64-linux-gnu-native-toolchain",
    host_system_name = "aarch64-linux-gnu",
    gcc_path = "/usr/bin/gcc",
    gxx_path = "/usr/bin/g++",
    ld_path = "/usr/bin/ld",
    ar_path = "/usr/bin/ar",
    cpp_path = "/usr/bin/cpp",
    gcov_path = "/usr/bin/gcov",
    nm_path = "/usr/bin/nm",
    objdump_path = "/usr/bin/objdump",
    strip_path = "/usr/bin/strip",
    cxx_builtin_include_directories = [
        "/usr/include/c++/13",
        "/usr/include/aarch64-linux-gnu/c++/13",
        "/usr/include/c++/13/backward",
        "/usr/lib/gcc/aarch64-linux-gnu/13/include",
        "/usr/lib/gcc/aarch64-linux-gnu/13/include-fixed",
        "/usr/aarch64-linux-gnu/include",
        "/usr/include/aarch64-linux-gnu",
        "/usr/include",
    ],
)

# x86_64 native toolchain configuration (x86_64 host -> x86_64 target)
cc_toolchain_config(
    name = "linux_x86_64_config",
    cpu = "x86_64",
    compiler = "gcc",
    target_system_name = "x86_64-linux-gnu",
    target_libc = "glibc_native",
    abi_version = "x86_64",
    abi_libc_version = "native",
    toolchain_identifier = "x86_64-linux-gnu-toolchain",
    host_system_name = "x86_64-linux-gnu",
    gcc_path = "/usr/bin/gcc",
    gxx_path = "/usr/bin/g++",
    ld_path = "/usr/bin/ld",
    ar_path = "/usr/bin/ar",
    cpp_path = "/usr/bin/cpp",
    gcov_path = "/usr/bin/gcov",
    nm_path = "/usr/bin/nm",
    objdump_path = "/usr/bin/objdump",
    strip_path = "/usr/bin/strip",
    cxx_builtin_include_directories = [
        "/usr/include/c++/13",
        "/usr/include/x86_64-linux-gnu/c++/13",
        "/usr/include/c++/13/backward",
        "/usr/lib/gcc/x86_64-linux-gnu/13/include",
        "/usr/lib/gcc/x86_64-linux-gnu/13/include-fixed",
        "/usr/include/x86_64-linux-gnu",
        "/usr/include",
    ],
)

# =============================================================================
# cc_toolchain definitions
# =============================================================================

cc_toolchain(
    name = "cc-toolchain-arm64-cross",
    toolchain_config = ":linux_arm64_cross_config",
    all_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 1,
)

cc_toolchain(
    name = "cc-toolchain-arm64-native",
    toolchain_config = ":linux_arm64_native_config",
    all_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 1,
)

cc_toolchain(
    name = "cc-toolchain-x86_64",
    toolchain_config = ":linux_x86_64_config",
    all_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 1,
)

cc_toolchain_suite(
    name = "toolchain",
    toolchains = {
        "aarch64|gcc": ":cc-toolchain-arm64-cross",
        "aarch64": ":cc-toolchain-arm64-cross",
        "x86_64|gcc": ":cc-toolchain-x86_64",
        "x86_64": ":cc-toolchain-x86_64",
    },
)

filegroup(name = "empty")

# =============================================================================
# Toolchain registrations
# =============================================================================

# Cross-compilation toolchain: x86_64 host -> ARM64 target
# Only this toolchain enables custom_glibc feature
toolchain(
    name = "cc-toolchain-arm64-linux-cross",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    toolchain = ":cc-toolchain-arm64-cross",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)

# Native toolchain: ARM64 host -> ARM64 target
toolchain(
    name = "cc-toolchain-arm64-linux-native",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
    toolchain = ":cc-toolchain-arm64-native",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)

# Native toolchain: x86_64 host -> x86_64 target
toolchain(
    name = "cc-toolchain-x86_64-linux",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":cc-toolchain-x86_64",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)
