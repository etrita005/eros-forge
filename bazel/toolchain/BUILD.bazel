load(":eros_cc_toolchains.bzl", "eros_cc_toolchain")
load(":constraints.bzl", "CROSS_ARM64", "EXEC_ARM64", "EXEC_X86_64", "NATIVE_ARM64", "NATIVE_X86_64")

package(default_visibility = ["//visibility:public"])

constraint_setting(
    name = "glibc_type",
    default_constraint_value = ":glibc_native",
)

constraint_value(
    name = "glibc_native",
    constraint_setting = ":glibc_type",
)

constraint_value(
    name = "glibc_cross",
    constraint_setting = ":glibc_type",
)

# =============================================================================
# Config settings
# =============================================================================
#
# Native configs (linux_x86_64, linux_arm64) are driven purely by platform
# constraint_values (NATIVE_X86_64 / NATIVE_ARM64 from constraints.bzl). They
# match the DEFAULT target platform (the host) when no --platforms is given,
# so a plain `bazel build` auto-detects the host architecture without any
# --define or --config. --config=auto is kept as a no-op alias for backward
# compatibility.
#
# Cross configs (linux_x86_64_cross_arm64, linux_arm64_cross_arm64) still use
# --define=eros_config=<key> because both target arm64+:glibc_cross and cannot
# be distinguished by target-platform constraints alone (the difference is the
# exec/host platform). constraint_values are added as well so the config_setting
# is only satisfied when the platform AND the define agree.
#
# Combined config_settings (e.g. linux_x86_64_asan) carry additional defines
# (eros_sanitizer, cmake_build_type) on top of the platform constraints. Bazel's
# select() specificity rule ensures the most specific matching condition wins.
# Sanitizer config_settings include cmake_build_type=Debug so they are strict
# supersets of the debug config_settings, avoiding ambiguity when combining
# --config=debug --config=asan.

config_setting(
    name = "linux_x86_64",
    constraint_values = NATIVE_X86_64,
)

config_setting(
    name = "linux_arm64",
    constraint_values = NATIVE_ARM64,
)

config_setting(
    name = "linux_x86_64_cross_arm64",
    constraint_values = CROSS_ARM64,
    define_values = {"eros_config": "linux_x86_64_cross_arm64"},
)

config_setting(
    name = "linux_arm64_cross_arm64",
    constraint_values = CROSS_ARM64,
    define_values = {"eros_config": "linux_arm64_cross_arm64"},
)

config_setting(
    name = "cmake_debug",
    define_values = {"cmake_build_type": "Debug"},
)

config_setting(
    name = "linux_x86_64_debug",
    constraint_values = NATIVE_X86_64,
    define_values = {"cmake_build_type": "Debug"},
)

config_setting(
    name = "linux_arm64_debug",
    constraint_values = NATIVE_ARM64,
    define_values = {"cmake_build_type": "Debug"},
)

config_setting(
    name = "linux_arm64_cross_arm64_debug",
    constraint_values = CROSS_ARM64,
    define_values = {
        "eros_config": "linux_arm64_cross_arm64",
        "cmake_build_type": "Debug",
    },
)

config_setting(
    name = "linux_x86_64_cross_arm64_debug",
    constraint_values = CROSS_ARM64,
    define_values = {
        "eros_config": "linux_x86_64_cross_arm64",
        "cmake_build_type": "Debug",
    },
)

config_setting(
    name = "tsan",
    define_values = {"eros_sanitizer": "tsan"},
)

config_setting(
    name = "msan",
    define_values = {"eros_sanitizer": "msan"},
)

config_setting(
    name = "asan",
    define_values = {"eros_sanitizer": "asan"},
)

config_setting(
    name = "ubsan",
    define_values = {"eros_sanitizer": "ubsan"},
)

config_setting(
    name = "linux_arm64_tsan",
    constraint_values = NATIVE_ARM64,
    define_values = {
        "eros_sanitizer": "tsan",
        "cmake_build_type": "Debug",
    },
)

config_setting(
    name = "linux_arm64_msan",
