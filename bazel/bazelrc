# EROS Unified Bazel Configuration
# Import this file in project .bazelrc: try-import %workspace%/../../forge/bazel/bazelrc

# =============================================================================
# Cross-compilation Configuration
# =============================================================================
#
# Build configurations:
# - build:x86_64      : x86_64 native compilation (on x86_64 host)
# - build:arm64       : ARM64 native compilation (on ARM64 host)
# - build:cross_arm64 : Cross-compilation from x86_64 to ARM64 (uses custom glibc)
#
# IMPORTANT: Do not assume host architecture. Use the appropriate config for your target.
# For native builds, Bazel automatically detects the host platform and selects the
# appropriate toolchain. Only use cross_arm64 when cross-compiling.

# Cross-compilation configurations (Bazel 9.0+)
build:x86_64 --platforms=@eros_forge//bazel/toolchain:linux_x86_64
build:arm64 --platforms=@eros_forge//bazel/toolchain:linux_arm64
build:cross_arm64 --platforms=@eros_forge//bazel/toolchain:linux_arm64_cross
build:cross_arm64 --linkopt=-Wl,--rpath=/opt/eros/lib
build:cross_arm64 --linkopt=-Wl,--dynamic-linker=/opt/eros/lib/ld-linux-aarch64.so.1

# Allow DEB_VERSION environment variable to be passed to actions
build --action_env=DEB_VERSION

# Default build settings
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

# Release build
build:release --compilation_mode=opt
build:release --copt=-O3
build:release --copt=-DNDEBUG

# Debug build
build:debug --compilation_mode=dbg
build:debug --copt=-g

# Test settings
test --test_output=errors
test --test_verbose_timeout_warnings
