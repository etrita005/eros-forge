# Import this file from consumer workspaces. Labels intentionally use the module name.
build --action_env=DEB_VERSION
build --action_env=PYTHONDONTWRITEBYTECODE=1
build --action_env=PYTHONNOUSERSITE=1
build --host_cxxopt=-std=c++20
# Target variants and packaging defines must not leak into native build tools.
build --incompatible_exclude_starlark_flags_from_exec_config
build --experimental_exclude_defines_from_exec_config

build:auto --@eros_forge//bazel/config:preset=auto
build:linux_x86_64 --platforms=@eros_forge//bazel/toolchain:linux_x86_64_platform
build:linux_x86_64 --@eros_forge//bazel/config:preset=linux_x86_64
build:linux_arm64 --platforms=@eros_forge//bazel/toolchain:linux_arm64_platform
build:linux_arm64 --@eros_forge//bazel/config:preset=linux_arm64
build:linux_x86_64_cross_arm64 --platforms=@eros_forge//bazel/toolchain:linux_x86_64_cross_arm64_platform
build:linux_x86_64_cross_arm64 --@eros_forge//bazel/config:preset=linux_x86_64_cross_arm64
build:linux_arm64_cross_arm64 --platforms=@eros_forge//bazel/toolchain:linux_arm64_cross_arm64_platform
build:linux_arm64_cross_arm64 --@eros_forge//bazel/config:preset=linux_arm64_cross_arm64

build:debug --compilation_mode=dbg
build:debug --define=cmake_build_type=Debug
build:release --compilation_mode=opt
build:release --define=cmake_build_type=Release
build:release --features=separate_debug_info

# ASan + UBSan is normalized from either config order. The canonical spelling
# --config=asan_ubsan also selects its generated Conan profile directly.
build:asan --features=asan
build:asan --@eros_forge//bazel/config:sanitizer=asan
build:asan --compilation_mode=dbg
build:asan --define=cmake_build_type=Debug
build:ubsan --features=ubsan
build:ubsan --@eros_forge//bazel/config:sanitizer=ubsan
build:ubsan --compilation_mode=dbg
build:ubsan --define=cmake_build_type=Debug
build:tsan --features=tsan
build:tsan --@eros_forge//bazel/config:sanitizer=tsan
build:tsan --compilation_mode=dbg
build:tsan --define=cmake_build_type=Debug
build:asan_ubsan --features=asan
build:asan_ubsan --features=ubsan
build:asan_ubsan --@eros_forge//bazel/config:sanitizer=asan_ubsan
build:asan_ubsan --compilation_mode=dbg
build:asan_ubsan --define=cmake_build_type=Debug
build:no_sanitizer --features=-asan
build:no_sanitizer --features=-ubsan
build:no_sanitizer --features=-tsan
build:no_sanitizer --features=-msan
build:no_sanitizer --@eros_forge//bazel/config:sanitizer=none

build:static_cpp_runtime --features=static_cpp_runtime
test --test_output=errors
test --test_verbose_timeout_warnings
