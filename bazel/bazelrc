# EROS Unified Bazel Configuration
# Import this file in project .bazelrc: try-import %workspace%/../../forge/bazel/bazelrc

# =============================================================================
# Build Configurations
# =============================================================================
#
# Supported configurations:
# - build:linux_x86_64              : Native x86_64 compilation (host=x86_64, target=x86_64)
# - build:linux_arm64               : Native ARM64 compilation (host=arm64, target=arm64)
# - build:linux_x86_64_cross_arm64  : Cross-compilation (host=x86_64, target=arm64)
# - build:linux_arm64_cross_arm64   : Cross-compilation (host=arm64, target=arm64)
#
# Usage examples:
#   bazel build //... --config=linux_x86_64
#   bazel build //... --config=linux_arm64
#   bazel build //... --config=linux_x86_64_cross_arm64
#   bazel build //... --config=linux_arm64_cross_arm64

# =============================================================================
# Platform Configurations
# =============================================================================

# linux_x86_64: Native x86_64 compilation
build:linux_x86_64 --platforms=@eros_forge//bazel/toolchain:linux_x86_64_platform
build:linux_x86_64 --define=eros_config=linux_x86_64

# linux_arm64: Native ARM64 compilation
build:linux_arm64 --platforms=@eros_forge//bazel/toolchain:linux_arm64_platform
build:linux_arm64 --define=eros_config=linux_arm64

# linux_x86_64_cross_arm64: Cross-compilation from x86_64 to ARM64
build:linux_x86_64_cross_arm64 --platforms=@eros_forge//bazel/toolchain:linux_arm64_platform
build:linux_x86_64_cross_arm64 --extra_toolchains=@eros_forge//bazel/toolchain:cc-toolchain-x86_64-to-arm64
build:linux_x86_64_cross_arm64 --define=eros_config=linux_x86_64_cross_arm64

# linux_arm64_cross_arm64: Cross-compilation from ARM64 to ARM64
build:linux_arm64_cross_arm64 --platforms=@eros_forge//bazel/toolchain:linux_arm64_platform
build:linux_arm64_cross_arm64 --extra_toolchains=@eros_forge//bazel/toolchain:cc-toolchain-arm64-to-arm64
build:linux_arm64_cross_arm64 --define=eros_config=linux_arm64_cross_arm64

# =============================================================================
# Environment Variables
# =============================================================================

build --action_env=DEB_VERSION

# =============================================================================
# Default Build Settings
# =============================================================================

build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

# =============================================================================
# Release Build (with symbol separation)
# =============================================================================

build:release --compilation_mode=opt
build:release --copt=-O3
build:release --copt=-DNDEBUG
build:release --copt=-g
build:release --linkopt=-Wl,-s
build:release --features=separate_debug_info

# =============================================================================
# Debug Build (with ASan + UBSan enabled by default)
# =============================================================================
#
# Debug mode enables AddressSanitizer and UndefinedBehaviorSanitizer by default
# to detect memory errors and undefined behavior during development.
#
# Detected issues:
# - Memory errors: buffer overflows, use-after-free, memory leaks
# - Undefined behavior: integer overflow, null pointer dereference, division by zero

build:debug --compilation_mode=dbg
build:debug --copt=-g
build:debug --features=asan
build:debug --features=ubsan

# =============================================================================
# CMake Build Configuration
# =============================================================================
#
# CMake projects need explicit CMAKE_BUILD_TYPE configuration.
# These settings ensure CMake projects use consistent build options with Bazel.
#
# Note: rules_foreign_cc's cmake rule uses the Bazel cc_toolchain, so
# compiler flags are automatically applied. But CMAKE_BUILD_TYPE must be
# explicitly set to ensure CMake's internal logic is consistent.

# Release mode for CMake: use -O3 optimization and disable debug assertions
build:release --define=cmake_build_type=Release

# Debug mode for CMake: enable debug symbols and assertions
build:debug --define=cmake_build_type=Debug

# =============================================================================
# Test Settings
# =============================================================================
#
# Sanitizers are configured in each test's BUILD.bazel for flexibility:
# - Regular tests: features = ["asan", "ubsan"]
# - Concurrent tests: features = ["-asan", "ubsan", "tsan"]
#
# This ensures all code (including dependencies) uses the same sanitizer.

test --test_output=errors
test --test_verbose_timeout_warnings

# =============================================================================
# Sanitizer Configurations (manual selection)
# =============================================================================
#
# Usage examples:
#   bazel build //... --config=asan    # AddressSanitizer only
#   bazel build //... --config=tsan    # ThreadSanitizer (for concurrent testing)
#   bazel build //... --config=msan    # MemorySanitizer
#
# Note: ASan and TSan are mutually exclusive
# Note: MSan requires all code (including libraries) to be compiled with MSan
# Note: Sanitizers use static linking (-static-libsan)

# AddressSanitizer (ASan) - Detects memory errors
# - Buffer overflows
# - Use-after-free
# - Use-after-return
# - Memory leaks
build:asan --features=asan
build:asan --compilation_mode=dbg

# ThreadSanitizer (TSan) - Detects data races
# - Data races
# - Deadlocks
build:tsan --features=tsan
build:tsan --compilation_mode=dbg

# UndefinedBehaviorSanitizer (UBSan) - Detects undefined behavior
# - Integer overflow
# - Null pointer dereference
# - Division by zero
build:ubsan --features=ubsan
build:ubsan --compilation_mode=dbg

# MemorySanitizer (MSan) - Detects uninitialized memory reads
# - Use of uninitialized memory
build:msan --features=msan
build:msan --compilation_mode=dbg
