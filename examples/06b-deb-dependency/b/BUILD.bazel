load("@eros_forge//bazel:deb.bzl", "pkg_eros_deb")
load("@eros_forge//bazel:runtime.bzl", "eros_cc_binary")

package(default_visibility = ["//visibility:public"])

eros_cc_binary(
    name = "app",
    srcs = ["main.cc"],
    deps = ["//06b-deb-dependency/a:answer"],
    linkstatic = False,
    install_name = "example-b",
    linkopts = ["-Wl,-rpath,$$ORIGIN/../../forge-example-a/lib"],
)

pkg_eros_deb(
    name = "b_deb",
    srcs = [":app"],
    package = "forge-example-b",
    version = "1.0.0",
    depends = ["//06b-deb-dependency/a:a_deb"],
)
