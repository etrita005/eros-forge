load("@eros_forge//bazel:deb.bzl", "pkg_eros_deb")
load("@eros_forge//bazel:runtime.bzl", "eros_cc_binary", "eros_install_map")

package(default_visibility = ["//visibility:public"])

eros_install_map(
    name = "resource",
    files = {"resource.txt": "share/debian-package.txt"},
)

eros_cc_binary(
    name = "app",
    srcs = ["main.cc"],
    data = [":resource"],
)

pkg_eros_deb(
    name = "deb",
    srcs = [":app"],
    package = "forge-example-debian-package",
    version = "1.2.3",
    description = "Forge private Debian package example",
    maintainer = "Forge Examples <examples@eros.invalid>",
)

pkg_eros_deb(
    name = "deb_default_version",
    srcs = [":app"],
    package = "forge-example-debian-package-default",
    description = "Forge private Debian package example",
    maintainer = "Forge Examples <examples@eros.invalid>",
)
