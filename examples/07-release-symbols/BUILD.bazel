load("@eros_forge//bazel:deb.bzl", "pkg_eros_tar")
load("@eros_forge//bazel:runtime.bzl", "eros_cc_binary")

package(default_visibility = ["//visibility:public"])

eros_cc_binary(
    name = "app",
    srcs = ["main.cc"],
)

pkg_eros_tar(
    name = "symbols",
    srcs = [":app"],
    output_group = "eros_debug_info",
    package = "forge-example-release-symbols",
)
