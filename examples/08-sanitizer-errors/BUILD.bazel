load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "dependency",
    srcs = ["dependency.cc"],
    hdrs = ["dependency.h"],
    copts = ["-g"],
    linkopts = ["-pthread"],
)

cc_binary(
    name = "app",
    srcs = ["main.cc"],
    deps = [":dependency"],
    copts = ["-g"],
    linkopts = ["-pthread"],
)
